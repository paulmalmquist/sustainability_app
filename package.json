{
  "name": "ppa-preflight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VPPA vs. REC analysis that audits its own assumptions before it shows a result, and learns new checks from expert reviewers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "export-skill": "node --experimental-strip-types scripts/export-skill.ts",
    "build:artifact": "npm run build:single && node scripts/build-artifact.mjs",
    "build:skill": "vite build --config vite.skill.config.ts && npm run export-skill"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
